# Production configuration for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   # fill in every value marked REQUIRED, then:
#   npm run prod:up
#
# Copy it to `.env.production`, which is gitignored. This file is committed and
# must never contain a real secret.
#
# The admin password is NOT here, deliberately. It is typed once at a hidden
# prompt — `cd backend && npm run admin:create` — so the platform's most
# privileged credential does not sit in a file for the life of the deployment.


# ── REQUIRED ────────────────────────────────────────────────────────────────

# Where the app will be reached, scheme and host, no trailing slash. The API's
# CORS allow-list is set from this, and nginx serves the app and the API on this
# one origin.
#   PUBLIC_ORIGIN=https://warehouse.example.com
PUBLIC_ORIGIN=

# Signs access tokens. Generate a fresh one — never reuse the development value,
# and never share it between environments: anyone holding it can mint a token for
# any account in the system.
#   openssl rand -hex 48
JWT_SECRET=

# The application's own MySQL user. Not root.
DB_NAME=warehouse_os
DB_USER=warehouse_app
DB_PASSWORD=

# MySQL's root password, used by the container to initialise the database and by
# its healthcheck. Not used by the application.
MYSQL_ROOT_PASSWORD=


# ── Ports ───────────────────────────────────────────────────────────────────

# The port nginx listens on, on the host. Behind a TLS terminator (Caddy, a load
# balancer, Cloudflare) 8080 keeps this off the public port.
#
# TLS IS NOT TERMINATED HERE. Serving this on a public :80 means passwords and
# access tokens travel in clear text. Put HTTPS in front of it — see
# docs/deployment.md.
HTTP_PORT=80


# ── Database pool ───────────────────────────────────────────────────────────

# Connections per API instance. Must leave room: instances x this, plus the
# operator's own session, has to stay under MySQL's max_connections (200 in the
# compose file).
DB_CONNECTION_LIMIT=20

# How many callers may wait for a connection before the API answers 503 instead
# of queueing. Without a bound, an overloaded server leaves requests hanging for
# ever rather than failing in a way a client or a load balancer can act on.
DB_QUEUE_LIMIT=50


# ── Tokens ──────────────────────────────────────────────────────────────────

# Short, because a leaked access token stays valid until it expires and cannot be
# revoked. The refresh token is what keeps people signed in, and that one can be
# revoked.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# ── Backups (§33) ───────────────────────────────────────────────────────────

# On by default here, because an unbacked-up deployment holding a business's
# stock and money is the worst state this system can be run in. The directory is
# a named Docker volume, set in the compose file.
BACKUP_SCHEDULE=true

# Minutes after local midnight. 120 = 02:00.
BACKUP_SCHEDULE_MINUTE=120

# Completed backups to keep. Older files and their rows are removed only AFTER a
# new backup succeeds, so a failing dump never deletes the last good one.
BACKUP_KEEP_LAST=14


# ── Logging ─────────────────────────────────────────────────────────────────

# info, warn, error. `debug` logs every request and is not for production.
LOG_LEVEL=info

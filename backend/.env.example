# Copy this file to .env and fill in real values for your machine.
# .env is git-ignored — never commit real secrets.

# ---- Server ----
NODE_ENV=development
PORT=4000
# Origin(s) the frontend dev server runs on — comma-separated if more than one.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Database (MySQL 8.x — see /docs/environment.md) ----
# This MUST point at the isolated MySQL 8.x instance (Docker, see root docker-compose.yml),
# never at the existing local MariaDB installation.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=warehouse_os_dev
DB_USER=warehouse_app
DB_PASSWORD=change_me_dev_password
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=3000

# ---- Auth foundation (architecture §8) ----
# No /api/auth/* routes exist yet in Phase 0 — these are unused until
# Phase 1 wires real login. Generate a real secret for local dev with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER reuse a placeholder value beyond your own machine, and never commit
# the real value (this file is a template — only `.env` is git-ignored).
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_SALT_ROUNDS=12

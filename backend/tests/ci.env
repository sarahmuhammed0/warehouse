# Applied on top of tests/test.env by `npm run test:ci`.
#
# Turns a missing database from a skip into a failure. With MySQL down, a plain
# `npm test` exits ZERO having run 104 of 350 tests: the integration suite skips,
# node:test counts no failures, and anything reading the exit code — a deploy
# pipeline, a pre-push hook — sees green having verified almost nothing.
#
# Skipping stays the default for local runs, where the unit tests are genuinely
# useful without a container running.
REQUIRE_DATABASE=true

# Test-run configuration, applied by `npm test` via node's --env-file.
#
# Loaded BEFORE dotenv reads .env, and dotenv never overwrites a variable that
# is already set — so these win for the test run and change nothing else. No
# secret belongs in this file: it is committed, and .env is not.

# Production hashes at cost 12 (~300ms of pure CPU, which is the point of it).
# node:test runs each test file as its own process, as many at once as there are
# cores, and a suite that hashes hundreds of passwords at cost 12 saturates the
# machine completely. Queries then slow down, connections stay checked out, and
# the pool queue — which waits without limit — backs up until tests that were
# merely waiting get reported as failures with durations in the minutes.
#
# Cost 4 removes that. It changes nothing a test asserts: the suite checks that
# a hash verifies and that a wrong password does not, which is true at any cost.
# The real factor is read from this same variable in production.
BCRYPT_SALT_ROUNDS=4

# Ten connections per process is right for one server. Across ~24 concurrent
# test processes it is up to 240, against a MySQL max_connections of 151. Three
# is more than a single test file ever needs, since tests within a file run in
# sequence.
DB_CONNECTION_LIMIT=3

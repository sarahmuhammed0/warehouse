# Root env file — read by docker-compose.yml only (MySQL container config).
# Copy to `.env` in this same folder. Git-ignored; never commit real values.
#
# These credentials must match backend/.env's DB_* values, since the backend
# connects to this same container as the MYSQL_USER below (never as root).

MYSQL_ROOT_PASSWORD=change_me_dev_root_password
MYSQL_DATABASE=warehouse_os_dev
MYSQL_USER=warehouse_app
MYSQL_PASSWORD=change_me_dev_password

# Host-side port MySQL is published on. 3307 by default, specifically NOT
# 3306, so it can never collide with an existing local MariaDB/MySQL install.
MYSQL_HOST_PORT=3307
